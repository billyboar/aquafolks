# Server
PORT=8080
ENVIRONMENT=development

# Database (will be replaced with Supabase URL later)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/aquabook?sslmode=disable

# Redis
REDIS_URL=localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Storage (MinIO for local development)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aquabook

# Backend base URL (used to build OAuth callback URLs)
BACKEND_URL=http://localhost:8080

# Frontend base URL
FRONTEND_URL=http://localhost:3000

# OAuth (add your credentials when ready)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
